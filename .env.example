APP_NAME=MediConnect
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=mediconnect
DB_USERNAME=mediconnect_app
DB_PASSWORD=
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Real-time (Laravel Reverb, CLAUDE.md §19). "null" is the safe default: no WebSocket server needed and
# /broadcasting/auth answers 503. To run Reverb locally (docker compose --profile realtime up reverb) set
# BROADCAST_CONNECTION=reverb and generate the three REVERB_APP_* values (any random strings; the secret stays server-side).
BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Private documents disk (D-36). Locally: SeaweedFS from mediconnect-infrastructure; use the
# S3_ACCESS_KEY / S3_SECRET_KEY / S3_BUCKET values from that repo's .env.
AWS_ACCESS_KEY_ID=mediconnect
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=mediconnect-private
AWS_ENDPOINT=http://seaweedfs:8333
AWS_USE_PATH_STYLE_ENDPOINT=true
DOCUMENTS_DISK=documents

# ClamAV daemon (D-07), on the compose network only
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30

VITE_APP_NAME="${APP_NAME}"
DB_OWNER_USERNAME=mediconnect_owner
DB_OWNER_PASSWORD=
SMS_DRIVER=disabled
# Push: "log" only records a line and is refused in production; "disabled" sends nothing (real FCM/APNs needs owner-provided credentials)
PUSH_DRIVER=log
# Minutes after which a push stuck in SENDING (worker died) may be claimed again
PUSH_RECLAIM_AFTER_MINUTES=10

# Doctor presence (Phase 5)
PRESENCE_CHECKIN_EARLY_MINUTES=60
PRESENCE_MAX_BREAK_MINUTES=240
# Lock wait before a presence change answers 409 (clamped to 100-10000 ms)
PRESENCE_LOCK_TIMEOUT_MS=3000

# Error tracking (empty = off)
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# Reverse proxies allowed to set X-Forwarded-For (empty = none; set behind a load balancer)
TRUSTED_PROXIES=

# First-party browser apps (cookie sessions). Comma-separated, never *.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:3001,localhost:8081

# Search (Typesense, Phase 3). Same key as TYPESENSE_API_KEY in mediconnect-infrastructure/.env.
TYPESENSE_HOST=typesense
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=
TYPESENSE_TIMEOUT_SECONDS=2
SEARCH_PREFIX=mc

# Reverb (only read when BROADCAST_CONNECTION=reverb)
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Where the API and workers publish events (compose service name) and where browsers and apps connect.
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
# Comma-separated host names (no scheme or port) allowed to open a WebSocket. Never "*": production refuses it.
REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1
# Scale Reverb horizontally through Redis (more than one reverb process).
REVERB_SCALING_ENABLED=false
